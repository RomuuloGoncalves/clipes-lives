# Copie para .env (chmod 600). NUNCA commite o .env real.

# --- Obrigatorio para Discord ---
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_GUILD_ID=
DISCORD_ALLOWED_USER_IDS=          # ids separados por virgula, ou * para todos

# --- Identificacao do PC / banco (opcional; fila distribuida) ---
CLIPES_ALIAS=
CLIPES_MONGO_URI=

# --- YouTube (token: ./clipar auth youtube) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# --- TikTok (publicacao fica privada ate a auditoria do app) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Twitch (so para monitorar por categoria, ainda nao implementado) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Marca (barra do layout); logo padrao: assets/logo.jpg ---
CLIPES_BRAND_NAME=
CLIPES_BRAND_DISPLAY=

# --- Opcionais (os padroes ja funcionam) ---
# CLIPES_LAYOUT=split-barra        # split-cheio | split-fina | full
# CLIPES_AGENDA_HORARIOS=11:30,19:00   # vazio = publica na hora
# CLIPES_TZ=America/Sao_Paulo
# CLIPES_MAX_LIVES=1               # lives simultaneas no acompanhar
# CLIPES_RETENCAO_H=               # vazio = nunca apaga o clipe local
# CLIPES_DISCORD_MAX_MB=20
