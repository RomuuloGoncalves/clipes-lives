# Copie para .env (chmod 600). NUNCA commite o .env real.

# --- Obrigatorio para Discord ---
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_GUILD_ID=
DISCORD_ALLOWED_USER_IDS=          # ids separados por virgula (recomendado); * libera qualquer membro do canal
# DISCORD_LOG_CHANNEL_ID=          # canal #bot-log (avisos); vazio = usa o canal de clipes

# --- Identificacao do PC / banco (controle pelo Discord exige Mongo) ---
CLIPES_ALIAS=                      # apelido unico do PC (ex.: PC-1)
CLIPES_MONGO_URI=                  # /live, /clipar e o servico multi-PC dependem dele

# --- YouTube (token: ./clipar auth youtube) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=                # alias opcional de YOUTUBE_CLIENT_ID
# GOOGLE_CLIENT_SECRET=            # alias opcional de YOUTUBE_CLIENT_SECRET

# --- TikTok (publicacao fica privada ate a auditoria do app) ---
TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_ID=                # alias opcional de TIKTOK_CLIENT_KEY
TIKTOK_CLIENT_SECRET=

# --- Twitch (opcional; API Helix para descobrir canais ao vivo no monitor) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Marca (barra do layout); logo padrao: assets/logo.jpg ---
CLIPES_BRAND_NAME=
CLIPES_BRAND_DISPLAY=
# CLIPES_BRAND_LOGO=               # caminho dentro do conteiner (ex.: /config/logo.jpg)

# --- LLM / ASR (opcionais; sem chave usa IA local) ---
# GEMINI_API_KEYS=                 # chaves Gemini separadas por virgula (opcional)
# CLIPES_GEMINI_MODELS=            # lista de modelos Gemini separados por virgula
# CLIPES_GEMINI_MIN_INTERVAL_S=4
# CLIPES_GEMINI_COTA_FILE=         # padrao: OUT_DIR/.gemini_cota.json
# CLIPES_CLOUD_TIMEOUT=20
# CLIPES_LLM_BACKEND=auto          # auto | local
# CLIPES_LLM_TIMEOUT=45
# CLIPES_WHISPER_MODEL=small       # small | large-v3-turbo
# CLIPES_CPU_THREADS=              # padrao: calculado automaticamente pelo ./clipar

# --- Portao de fala pos-ASR (opcional; medir offline: python -m clipes.eval portao /out) ---
# CLIPES_PORTAO=log                # off | log | on (log so registra, sem descartar)
# CLIPES_MIN_WPS=0.4               # palavras por segundo minimas para manter o clipe
# CLIPES_MIN_PALAVRAS=15           # minimo absoluto de palavras no clipe

# --- Render, barra, layout e facecam (opcionais) ---
# CLIPES_LAYOUT=split-barra        # split-barra | split-cheio | split-fina | full
# CLIPES_BAR=                      # 1/0 (padrao: liga com CLIPES_BRAND_NAME)
# CLIPES_BAR_STYLE=claro           # claro | escuro
# CLIPES_BAR_H=420                 # 300..600
# CLIPES_HOOK_TOP=1
# CLIPES_BLUR_BG=0                 # 1 liga fundo desfocado (mais CPU)
# CLIPES_SPLIT_BAR_H=
# CLIPES_SPLIT_CAM_H=
# CLIPES_FACECAM_TTL_H=12
# CLIPES_FACECAM_CONFIG=           # padrao: /config/facecam.json

# --- Lives, disco, fila e politica (opcionais) ---
# OUT_DIR=./out
# CLIPES_POLICY_FILE=              # padrao: OUT_DIR/policy.json
# CLIPES_MAX_LIVES=                # obsoleto: ignorado; use CLIPES_SLOTS
# CLIPES_SLOTS=twitch=1,kick=1,youtube=1,busca=1   # slots por plataforma neste PC no ./clipar servico (0 desliga a plataforma)
# CLIPES_MIN_FREE_GB=5
# CLIPES_BUFFER_CAP_GB=1.5
# CLIPES_LIVE_CAPTURA_MORTA_S=900
# CLIPES_BEAT_S=20
# CLIPES_LEASE_S=90

# --- Discord, registro, retencao e publicacao (opcionais) ---
# CLIPES_DISCORD_MAX_MB=20
# CLIPES_MASTER_MODE=discord       # discord | livre
# CLIPES_REGISTRO_VERIFICAR=1
# CLIPES_RETENCAO_H=               # vazio = nunca apaga o clipe local
# CLIPES_TOKENS_PATH=              # padrao: /config/tokens.json
# CLIPES_QUOTA_PATH=               # padrao: OUT_DIR/.cotas_publicacao.json
# CLIPES_OAUTH_BIND=127.0.0.1
# CLIPES_OAUTH_PORT=8765
# CLIPES_YT_MAX_DIA=6
# CLIPES_TIKTOK_MAX_DIA=5
# CLIPES_PUB_LEASE_S=1800
# CLIPES_PUB_MAX_POR_CICLO=3
# CLIPES_AGENDA_HORARIOS=11:30,19:00   # vazio = publica na hora
# CLIPES_TZ=America/Sao_Paulo
