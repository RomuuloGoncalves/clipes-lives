#!/bin/sh
# Uso: ./clipar <url> [opcoes]   (ou ./clipar servico ...)
# Cria a pasta de saida como seu usuario antes do Docker (senao ele a cria como root, com cadeado).
# Limita a CPU (CLIPES_CPUS, automatico ou usuario) e RAM (CLIPES_MEM), baixa a prioridade e liga o vigia termico.
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
SECRETS="${CLIPES_SECRETS:-$ROOT/.env}"
if [ -f "$SECRETS" ]; then
  MODE=$(stat -L -c '%a' "$SECRETS" 2>/dev/null)
  [ "$MODE" != "600" ] && echo "aviso: $SECRETS tem modo $MODE (esperado 600)" >&2
  case "$SECRETS" in */*) ;; *) SECRETS="./$SECRETS" ;; esac
  set -a
  . "$SECRETS"
  set +a
fi
OUT_DIR="${OUT_DIR:-$ROOT/out}"
mkdir -p "$OUT_DIR" && export OUT_DIR
HOST_UID="${HOST_UID:-$(id -u)}"
HOST_GID="${HOST_GID:-$(id -g)}"
export HOST_UID HOST_GID

SYSFS_ROOT="${SYSFS_ROOT:-/sys}"
PROC_ROOT="${PROC_ROOT:-/proc}"

mem_kb=""
if [ -r "$PROC_ROOT/meminfo" ]; then
  while read -r k v _; do
    if [ "$k" = "MemAvailable:" ]; then
      mem_kb="$v"
      break
    fi
  done < "$PROC_ROOT/meminfo"
fi
case "$mem_kb" in ''|*[!0-9]*) mem_kb="" ;; esac

# Valores do ambiente/.env (o painel, via $OUT_DIR/.recursos, tem precedencia e e relido a cada reinicio).
ENV_CPUS="${CLIPES_CPUS:-}"
ENV_MEM="${CLIPES_MEM:-}"
ENV_CPU_THREADS="${CLIPES_CPU_THREADS:-}"
CLIPES_RECURSOS_GERIDO=1
export CLIPES_RECURSOS_GERIDO

calc_recursos() {
  CLIPES_CPUS="$ENV_CPUS"
  CLIPES_MEM="$ENV_MEM"
  painel_mem="-"
  painel_cpus="-"
  if [ -r "$OUT_DIR/.recursos" ]; then
    read -r painel_mem painel_cpus < "$OUT_DIR/.recursos" 2>/dev/null || true
  fi
  case "$painel_mem" in
    [0-9]*[mg]) CLIPES_MEM="$painel_mem" ;;
  esac
  case "$painel_cpus" in
    ''|-|*[!0-9.]*) ;;
    *) CLIPES_CPUS="$painel_cpus" ;;
  esac
  if [ -z "${CLIPES_CPUS:-}" ]; then
    cpus_host=$(nproc 2>/dev/null || getconf _NPROCESSORS_ONLN 2>/dev/null || echo 1)
    case "$cpus_host" in ''|*[!0-9]*) cpus_host=1 ;; esac
    tem_bat=0
    for b in "$SYSFS_ROOT"/class/power_supply/BAT*; do
      [ -e "$b" ] && tem_bat=1 && break
    done
    if [ "$tem_bat" = 1 ] || { [ -n "$mem_kb" ] && [ "$mem_kb" -lt 4194304 ]; }; then
      CLIPES_CPUS=$(( cpus_host / 4 ))
    else
      CLIPES_CPUS=$(( cpus_host / 2 ))
    fi
    [ "$CLIPES_CPUS" -lt 1 ] && CLIPES_CPUS=1
  fi
  export CLIPES_CPUS
  if [ -z "${CLIPES_MEM:-}" ]; then
    if [ -n "$mem_kb" ] && [ "$mem_kb" -gt 0 ]; then
      mem_mb=$(( (mem_kb * 60) / 102400 ))
      [ "$mem_mb" -gt 5120 ] && mem_mb=5120
      [ "$mem_mb" -lt 1 ] && mem_mb=1
      CLIPES_MEM="${mem_mb}m"
    else
      CLIPES_MEM="5120m"
    fi
  fi
  export CLIPES_MEM
  threads_auto="${CLIPES_CPUS%%.*}"
  case "$threads_auto" in ''|0|*[!0-9]*) threads_auto=1 ;; esac
  CLIPES_CPU_THREADS="${ENV_CPU_THREADS:-$threads_auto}"
  export CLIPES_CPU_THREADS
}
calc_recursos

D="$(dirname "$0")"
# Vigia ja vivo para este OUT_DIR (outro ./clipar ou servico): nao inicia outro e nao o mata.
vivo=0
if [ -r "$OUT_DIR/.vigia.pid" ]; then
  old=$(cat "$OUT_DIR/.vigia.pid" 2>/dev/null)
  case "$old" in ''|*[!0-9]*) ;; *) kill -0 "$old" 2>/dev/null && vivo=1 ;; esac
fi
if [ "$("$D/vigia-temp" --check 2>/dev/null)" = "sem-sensor" ]; then
  echo "aviso: sem sensor de temperatura; vigia termico desligado" >&2
  case "$(cat "$PROC_ROOT/version" 2>/dev/null)" in
    *[Mm]icrosoft*) echo "aviso: no WSL, abra o LibreHardwareMonitor no Windows (como administrador) com o servidor WMI ligado" >&2 ;;
  esac
fi
V=""
if [ "$vivo" = 0 ]; then
  "$D/vigia-temp" & V=$!
fi
# So mata (e despausa) o vigia que este ./clipar iniciou.
fim() {
  if [ -n "$V" ]; then
    kill $V 2>/dev/null
    docker unpause $(docker ps -q --filter label=com.docker.compose.project=clipes-lives --filter label=com.docker.compose.service=clipes) >/dev/null 2>&1
  fi
}
trap fim EXIT INT TERM

DASH_PORT_FLAG=""
for arg in "$@"; do
  if [ "$arg" = "--dashboard" ]; then
    p="${PAINEL_PORT:-8787}"
    DASH_PORT_FLAG="-p 127.0.0.1:${p}:${p}"
    break
  fi
done

while :; do
  calc_recursos
  # shellcheck disable=SC2086
  nice -n 19 docker compose run --rm $DASH_PORT_FLAG clipes "$@"
  rc=$?
  if [ "$rc" -ne 75 ]; then
    exit "$rc"
  fi
  sleep "${CLIPES_RESTART_S:-60}"
done
