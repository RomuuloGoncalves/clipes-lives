#!/bin/sh
# Uso: ./clipar <url> [opcoes]   (ou ./clipar monitor ...)
# Cria a pasta de saida como seu usuario antes do Docker (senao ele a cria como root, com cadeado).
# Limita a CPU (CLIPES_CPUS, automatico ou usuario) e RAM (CLIPES_MEM), baixa a prioridade e liga o vigia termico.
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
SECRETS="${CLIPES_SECRETS:-$ROOT/.env}"
if [ -f "$SECRETS" ]; then
  MODE=$(stat -L -c '%a' "$SECRETS" 2>/dev/null)
  [ "$MODE" != "600" ] && echo "aviso: $SECRETS tem modo $MODE (esperado 600)" >&2
  case "$SECRETS" in */*) ;; *) SECRETS="./$SECRETS" ;; esac
  set -a
  . "$SECRETS"
  set +a
fi
OUT_DIR="${OUT_DIR:-$ROOT/out}"
mkdir -p "$OUT_DIR" && export OUT_DIR
HOST_UID="${HOST_UID:-$(id -u)}"
HOST_GID="${HOST_GID:-$(id -g)}"
export HOST_UID HOST_GID

SYSFS_ROOT="${SYSFS_ROOT:-/sys}"
PROC_ROOT="${PROC_ROOT:-/proc}"

mem_kb=""
if [ -r "$PROC_ROOT/meminfo" ]; then
  while read -r k v _; do
    if [ "$k" = "MemAvailable:" ]; then
      mem_kb="$v"
      break
    fi
  done < "$PROC_ROOT/meminfo"
fi
case "$mem_kb" in ''|*[!0-9]*) mem_kb="" ;; esac

if [ -z "${CLIPES_CPUS:-}" ]; then
  cpus_host=$(nproc 2>/dev/null || getconf _NPROCESSORS_ONLN 2>/dev/null || echo 1)
  case "$cpus_host" in ''|*[!0-9]*) cpus_host=1 ;; esac
  tem_bat=0
  for b in "$SYSFS_ROOT"/class/power_supply/BAT*; do
    [ -e "$b" ] && tem_bat=1 && break
  done
  if [ "$tem_bat" = 1 ] || { [ -n "$mem_kb" ] && [ "$mem_kb" -lt 4194304 ]; }; then
    CLIPES_CPUS=$(( cpus_host / 4 ))
  else
    CLIPES_CPUS=$(( cpus_host / 2 ))
  fi
  [ "$CLIPES_CPUS" -lt 1 ] && CLIPES_CPUS=1
fi
export CLIPES_CPUS

if [ -z "${CLIPES_MEM:-}" ]; then
  if [ -n "$mem_kb" ] && [ "$mem_kb" -gt 0 ]; then
    mem_mb=$(( (mem_kb * 60) / 102400 ))
    [ "$mem_mb" -gt 8192 ] && mem_mb=8192
    [ "$mem_mb" -lt 1 ] && mem_mb=1
    CLIPES_MEM="${mem_mb}m"
  else
    CLIPES_MEM="8192m"
  fi
fi
export CLIPES_MEM

CLIPES_CPU_THREADS="${CLIPES_CPU_THREADS:-$CLIPES_CPUS}"
export CLIPES_CPU_THREADS

D="$(dirname "$0")"
if [ "$("$D/vigia-temp" --check 2>/dev/null)" = "sem-sensor" ]; then
  echo "aviso: sem sensor de temperatura; vigia termico desligado" >&2
fi
"$D/vigia-temp" & V=$!
fim() { kill $V 2>/dev/null; docker unpause $(docker ps -q --filter label=com.docker.compose.project=clipes-lives) >/dev/null 2>&1; }
trap fim EXIT INT TERM

while :; do
  nice -n 19 docker compose run --rm clipes "$@"
  rc=$?
  if [ "$rc" -ne 75 ]; then
    exit "$rc"
  fi
  sleep "${CLIPES_RESTART_S:-60}"
done
