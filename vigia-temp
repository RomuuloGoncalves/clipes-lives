#!/bin/sh
# Vigia termico: pausa os containers do projeto acima de MAX C e retoma abaixo de MIN C.
# Registra a temperatura em $LOG (padrao $OUT_DIR/.temp.log) e o valor atual em $OUT_DIR/.temp.
SYSFS_ROOT="${SYSFS_ROOT:-/sys}"
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
OUT_DIR="${OUT_DIR:-$ROOT/out}"
LOG="${LOG:-$OUT_DIR/.temp.log}"

ler_temp() {
  TEMP=""
  t=""
  for h in "$SYSFS_ROOT"/class/hwmon/hwmon*; do
    [ -r "$h/name" ] || continue
    case "$(cat "$h/name" 2>/dev/null)" in
      k10temp|zenpower|coretemp|cpu_thermal) ;;
      *) continue ;;
    esac
    for f in "$h"/temp*_input; do
      [ -r "$f" ] || continue
      raw=$(cat "$f" 2>/dev/null)
      case "${raw#-}" in ''|*[!0-9]*) continue ;; esac
      v=$(( raw / 1000 ))
      if [ -z "$t" ] || [ "$v" -gt "$t" ]; then t=$v; fi
    done
  done
  if [ -z "$t" ]; then
    for z in "$SYSFS_ROOT"/class/thermal/thermal_zone*/temp; do
      [ -r "$z" ] || continue
      raw=$(cat "$z" 2>/dev/null)
      case "${raw#-}" in ''|*[!0-9]*) continue ;; esac
      v=$(( raw / 1000 ))
      if [ -z "$t" ] || [ "$v" -gt "$t" ]; then t=$v; fi
    done
  fi
  if [ -z "$t" ] && grep -qi microsoft "${PROC_ROOT:-/proc}/version" 2>/dev/null; then
    agora=$(date +%s)
    if [ -z "${WIN_TS:-}" ] || [ $((agora - WIN_TS)) -ge 15 ]; then
      WIN_TS=$agora
      WIN_T=$(timeout 5 powershell.exe -NoProfile -Command '$t=(Get-CimInstance -Namespace root/LibreHardwareMonitor -ClassName Sensor -ErrorAction SilentlyContinue | Where-Object {$_.SensorType -eq "Temperature" -and $_.Name -match "CPU|Core|Package"} | Measure-Object -Property Value -Maximum).Maximum; if (-not $t) {$z=(Get-CimInstance -Namespace root/wmi -ClassName MSAcpi_ThermalZoneTemperature -ErrorAction SilentlyContinue | Measure-Object -Property CurrentTemperature -Maximum).Maximum; if ($z) {$t=$z/10-273.15}}; if ($t) {[int]$t}' 2>/dev/null | tr -d '\r' | head -n1)
      WIN_T=${WIN_T%%.*}
      case "$WIN_T" in ''|*[!0-9]*) WIN_T="" ;; esac
    fi
    t=$WIN_T
  fi
  TEMP="${t:-sem-sensor}"
}

if [ "${1:-}" = "--check" ]; then
  ler_temp; printf '%s\n' "$TEMP"
  exit 0
fi

mkdir -p "$OUT_DIR" "$(dirname "$LOG")"
PIDFILE="$OUT_DIR/.vigia.pid"
if [ -r "$PIDFILE" ]; then
  old=$(cat "$PIDFILE" 2>/dev/null)
  case "$old" in ''|*[!0-9]*) ;; *) [ "$old" != "$$" ] && kill -0 "$old" 2>/dev/null && exit 0 ;; esac
fi
echo $$ > "$PIDFILE"

# Le $OUT_DIR/.vigia ("ativo max min"); invalido -> env/padroes.
ler_cfg() {
  ATIVO="${CLIPES_VIGIA:-1}"; MAX="${CLIPES_TEMP_MAX:-85}"; MIN="${CLIPES_TEMP_MIN:-75}"
  a=""; mx=""; mn=""
  read a mx mn < "$OUT_DIR/.vigia" 2>/dev/null || true
  case "$a$mx$mn" in *[!0-9]*|'') return ;; esac
  [ -n "$a" ] && [ -n "$mx" ] && [ -n "$mn" ] || return
  [ "$a" -le 1 ] && [ "$mx" -ge 60 ] && [ "$mx" -le 100 ] && [ "$mn" -ge 40 ] && [ "$mn" -le 95 ] && [ "$mn" -lt "$mx" ] || return
  ATIVO=$a; MAX=$mx; MIN=$mn
}

pausado=0
trap 'rm -f "$PIDFILE"; ids=$(docker ps -q --filter label=com.docker.compose.project=clipes-lives --filter label=com.docker.compose.service=clipes); [ -n "$ids" ] && docker unpause $ids >/dev/null 2>&1; exit' INT TERM EXIT

while :; do
  ler_cfg
  ler_temp; t=$TEMP
  printf '%s\n' "$t" > "$OUT_DIR/.temp.tmp.$$" && mv -f "$OUT_DIR/.temp.tmp.$$" "$OUT_DIR/.temp"
  if [ "$t" = "sem-sensor" ]; then
    echo "$(date +%T) sem-sensor pausado=$pausado ativo=$ATIVO" >> "$LOG"; sync "$LOG" 2>/dev/null
    if [ "$pausado" = 1 ]; then
      ids=$(docker ps -q --filter label=com.docker.compose.project=clipes-lives --filter label=com.docker.compose.service=clipes)
      [ -n "$ids" ] && docker unpause $ids >/dev/null 2>&1
      pausado=0
    fi
  else
    echo "$(date +%T) ${t}C pausado=$pausado ativo=$ATIVO" >> "$LOG"; sync "$LOG" 2>/dev/null
    ids=$(docker ps -q --filter label=com.docker.compose.project=clipes-lives --filter label=com.docker.compose.service=clipes)
    if [ "$ATIVO" = 0 ]; then
      if [ "$pausado" = 1 ]; then
        [ -n "$ids" ] && docker unpause $ids >/dev/null 2>&1
        pausado=0
      fi
    elif [ "$pausado" = 0 ] && [ "$t" -ge "$MAX" ]; then
      [ -n "$ids" ] && docker pause $ids >/dev/null 2>&1
      pausado=1
    elif [ "$pausado" = 1 ] && [ "$t" -le "$MIN" ]; then
      [ -n "$ids" ] && docker unpause $ids >/dev/null 2>&1
      pausado=0
    fi
  fi
  sleep 5
done
